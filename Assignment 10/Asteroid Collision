class Solution {
    public int[] asteroidCollision(int[] a) {
        Stack<Integer>st=new Stack<>();
        for(int i=0;i<a.length;i++)
        {
            if(st.isEmpty()||a[i]>0)
            st.push(a[i]);
            else
            {
           while(!st.isEmpty()) 
            {
              int top=st.peek();
              if(top<0)
              {
              st.push(a[i]);
              break;
              }
              else{
                int modval=Math.abs(a[i]);
                if(modval==top)
                {
                    st.pop();
                     break;
                }
                else if(modval<top)
                break;
                else
                {
                st.pop();
                if(st.isEmpty())
                {
                st.push(a[i]);
                break;
                }
                }

              }
            }
            }
        }
    
        int []arr=new int[st.size()];
        for(int i=st.size()-1;i>=0;i--)
        {
            arr[i]=st.pop();
        }
        return arr;

    }
}
