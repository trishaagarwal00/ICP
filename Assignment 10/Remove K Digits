class Solution {
    public String removeKdigits(String s, int k) {
        // code here
        Stack<Character>st =new Stack<>();
        for(int i=0;i<s.length();i++)
        {
            while(!st.isEmpty()&&k>0&&(st.peek()-'0')>(s.charAt(i)-'0'))
            {
                st.pop();
                k--;
            }
            st.push(s.charAt(i));
        }
            while(k>0)
            {
                k--;
                st.pop();
            }
            if(st.isEmpty())
            return "0";
           String result="";
           while(!st.isEmpty())
           {
               result=result+st.peek();
               st.pop();
           }
           int n;
           for( n=result.length()-1;n>0;n--)
           {
               if(result.charAt(n)!='0')
               break;
           }
           String res="";
           for(int i=n;i>=0;i--)
           {
               res=res+result.charAt(i);
           }
           return res;
           
        
    }
}
